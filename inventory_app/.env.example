# Environment Configuration for REAL-ED Inventory App
# 
# Copy this file to inventory_app/.env and customize for your deployment.
# The app will load these variables at startup to determine runtime paths.

# Primary runtime root: points to either SSD (2000 MASTER) or LANIA failover location
# Usage: All scripts resolve DB, backup, and deployment paths relative to this root
# Examples:
#   INVENTORY_RUNTIME_ROOT=/Volumes/2000 MASTER/REAL-ED-INVENTORY-main/REAL-ED-INVENTORY-main
#   INVENTORY_RUNTIME_ROOT=/Volumes/LANIA/REAL-ED-COLD-CLONES/cold_clone_20260522T110315Z
INVENTORY_RUNTIME_ROOT=/Volumes/2000 MASTER/REAL-ED-INVENTORY-main/REAL-ED-INVENTORY-main

# Database paths (relative to INVENTORY_RUNTIME_ROOT)
INVENTORY_DB_MASTER=sql_inventory_master.db
INVENTORY_DB_SB1=sql_inventory_sb1.db
INVENTORY_DB_SB2=sql_inventory_sb2.db
INVENTORY_DB_SB3=sql_inventory_sb3.db

# Backup target for primary backups (typically on same volume as runtime)
# On failover, this will be updated to LANIA equivalent
INVENTORY_BACKUP_PRIMARY="${INVENTORY_RUNTIME_ROOT}/inventory_app/backups"

# Secondary backup target (LANIA DR mount)
# Keep synchronized as the disaster recovery anchor
INVENTORY_BACKUP_SECONDARY=/Volumes/LANIA/REAL-ED-DR

# Optional: offsite encrypted backup destination
# Leave empty if not in use
INVENTORY_BACKUP_OFFSITE=

# Database snapshot directory (relative to INVENTORY_RUNTIME_ROOT)
INVENTORY_SNAPSHOTS_DIR=inventory_app/backups/db_snapshots

# SB3 specific backup location on LANIA
INVENTORY_SB3_BACKUP_LANIA=/Volumes/LANIA/REAL-ED-DR/sb3_backups

# Git repository roots (for backup/sync operations)
# These may differ from INVENTORY_RUNTIME_ROOT for multi-repo setups
GIT_MAIN_REPO="${INVENTORY_RUNTIME_ROOT}"
GIT_MAIN2_REPO="/Volumes/LANIA/REAL-ED-INVENTORY-main/REAL-ED-INVENTORY-main-2"

# Backup retention policy (days)
INVENTORY_BACKUP_RETENTION_DAYS=30

# Logging configuration
INVENTORY_LOG_DIR=/var/log
INVENTORY_SB3_REHEARSAL_LOG="${INVENTORY_LOG_DIR}/sb3-rehearsal.log"

# Port assignments for sandboxes
INVENTORY_PORT_SB1=5050
INVENTORY_PORT_SB2=5051
INVENTORY_PORT_SB3=5052

# Failover detection: set to 'true' to auto-probe for primary mount, then fallback to LANIA
INVENTORY_FAILOVER_AUTO_DETECT=false
